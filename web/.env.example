# Copy to .env.local and fill in. Next.js loads it for `next dev` and `next start`.

# --- Browser --------------------------------------------------------------------------------------------
# RPC the dashboard and checkout use for devnet. The public endpoint rate-limits hard; a dedicated one is smoother.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=...
# NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# --- Payment server (app/api/invoices, src/server) --------------------------------------------------------
# The listener needs a long-running server: `next start` on a VM or container (or `next dev`). On serverless
# hosts nothing stays up to listen; POST /api/invoices/<reference>/verify still settles invoices on demand.
# With the default file store, run one server process. For several processes or serverless instances, use the
# postgres store (below).

# --- Merchant sign-in (Sign-In with Solana; app/api/auth) --------------------------------------------------
# Creating and canceling invoices needs a session: the merchant's wallet signs a SIWS message, and the session
# lives in an HTTP-only cookie. Checkout pages and invoice status stay public.
# Signs the session cookies (HMAC-SHA256): at least 32 characters, and the same on every instance. Unset: a random
# key is generated once and kept in the data directory (SOLAGENT_DATA_DIR/session-secret), so one server works
# with no setup and sign-ins survive restarts. Set it when several instances share the postgres store.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SOLAGENT_SESSION_SECRET=
# This app's public origin. Sign-in messages name it and only it is accepted, so a signature a phishing site
# collected for its own domain can't be used here. https makes cookies Secure + __Host-. Unset: requests to this
# machine (localhost, 127.0.0.1) use their own origin, in `next dev` and `next start` alike, so a local build signs
# in on devnet with no setup. Required before serving on a public address: sign-in and Blinks answer 503 there
# until it's set.
# SOLAGENT_APP_URL=https://pay.example.com
# How long a sign-in lasts, in hours (default 12).
# SOLAGENT_SESSION_TTL_HOURS=12
#
# Solana Actions (Blinks) need no settings of their own: /actions.json (also /.well-known/actions.json) maps
# checkout links to /api/actions/pay, and the action cards link their icon under SOLAGENT_APP_URL. Blink clients
# fetch actions from their own servers, so blinks only unfurl once the app is on a public https URL; X also needs
# the domain registered with Dialect's blinks registry.

# Where `payment.succeeded` events are POSTed. Unset: events are recorded but not sent, and the console's
# "Send test webhook" goes to the built-in receiver at /api/webhooks/receiver (which checks the signature and
# stores nothing), so you can try deliveries before you have an endpoint.
# SOLAGENT_WEBHOOK_URL=https://api.example.com/solagent/webhooks
# HMAC-SHA256 key for the X-SolAgent-Signature header (t=<unix seconds>,v1=<hex of HMAC("<t>.<body>")>).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SOLAGENT_WEBHOOK_SECRET=

# Unpaid invoices expire after this many minutes (default 15). Orders opened through a product's Blink expire after
# at most 10 minutes: the buyer's wallet asks for the transaction and signs it right away, or not at all.
# SOLAGENT_INVOICE_TTL_MINUTES=15

# Products each merchant can have on sale at once (default 100).
# SOLAGENT_MAX_PRODUCTS=100

# --- cNFT receipts (Underdog Protocol; src/server/receipts.ts) ----------------------------------------------
# When a product order, PoS sale or dashboard invoice settles, the buyer's wallet (read from the paying transaction)
# is sent a compressed NFT: "Receipt: <product>", the product image, and Price / TxSignature / Timestamp / Order
# attributes. Underdog pays for and submits the mint. Unset: receipts are simulated, logged as
# "receipt INV-1001 (simulated): would mint …" and shown as simulated, so local development needs no account.
# Create a project in Underdog's dashboard (or POST /v2/projects), then set its API key and project id.
# UNDERDOG_API_KEY=
# UNDERDOG_PROJECT_ID=
# The network the key mints on: devnet (default, devnet.underdogprotocol.com) or mainnet-beta
# (mainnet.underdogprotocol.com). Sales on any other network get simulated receipts, never real ones.
# UNDERDOG_NETWORK=devnet
# Overrides the API base URL for UNDERDOG_NETWORK.
# UNDERDOG_API_URL=https://devnet.underdogprotocol.com
# A product without an image gets the generated token icon on its receipt, served under SOLAGENT_APP_URL.

# Only these wallets can sign in (comma-separated), and so create invoices. Recommended in production, so
# strangers can't use this server to watch and webhook their own payments. Unset: any wallet can sign in.
# SOLAGENT_MERCHANT_WALLETS=YourWalletAddress1,YourWalletAddress2

# Server-side RPC, per network (DEVNET, LOCALNET, MAINNET_BETA). Defaults to the browser endpoints above.
# SOLAGENT_RPC_URL_DEVNET=https://devnet.helius-rpc.com/?api-key=...
# Websocket for logsSubscribe; derived from the RPC URL when unset (https -> wss, local port 8899 -> 8900).
# SOLAGENT_WS_URL_DEVNET=wss://devnet.helius-rpc.com/?api-key=...
# Requests per second to each RPC endpoint (default 4; the public devnet endpoint rate-limits around there).
# SOLAGENT_RPC_RPS=4

# Most open invoices watched at once (default 500).
# SOLAGENT_MAX_OPEN_INVOICES=500

# --- Store ------------------------------------------------------------------------------------------------
# "file" (default): one JSON file, one server process. "postgres": shared by any number of processes or
# serverless instances. Apply the schema first: psql "$DATABASE_URL" -f web/db/schema.sql
# SOLAGENT_STORE=file
# Where the file store's JSON file lives (default web/.data).
# SOLAGENT_DATA_DIR=/var/lib/solagent-pay
# PostgreSQL connection string for the postgres store (DATABASE_URL works too).
# SOLAGENT_DATABASE_URL=postgres://user:password@host:5432/solagent
# Connections per instance (default 5). Keep it small on serverless hosts, where each instance has a pool.
# SOLAGENT_DATABASE_POOL_MAX=5
