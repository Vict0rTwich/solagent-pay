{
  "name": "@solagent-pay/web",
  "version": "0.1.0",
  "private": true,
  "description": "SolAgent Pay merchant dashboard",
  "scripts": {
    "sdk": "npm run build --workspace=@solagent-pay/sdk",
    "dev": "npm run sdk && next dev --port 3000",
    "build": "npm run sdk && next build",
    "start": "next start --port 3000",
    "typecheck": "npm run sdk && tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solagent-pay/sdk": "^0.1.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/web3.js": "~1.98.4",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.4.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
