{
  "name": "@solagent-pay/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets an AI agent check and spend from its SolAgent Pay wallet",
  "main": "dist/index.js",
  "bin": {
    "solagent-pay-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@solagent-pay/sdk": "^0.1.0",
    "@solana/web3.js": "~1.98.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
